# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/

# IDE and operating-system metadata
.vscode/
.idea/
.vs/
.DS_Store
Thumbs.db

# HEVC/HM build trees (large generated output)
stego/**/build/

# Generated compiler and linker files outside build directories
*.obj
*.o
*.lib
*.a
*.dll
*.pdb
*.idb
*.ilk
*.exp
*.tlog
*.lastbuildstate
*.cache
*.recipe
*.manifest
*.sdf
*.suo
*.user
*.opensdf
*.ipch
*.iobj
*.ipdb

# Generated logs and temporary files
*.log
*.tmp
*.temp

# Keep executable deliverables
!*.exe

# Decoder implementations are intentionally not distributed. Users provide
# their own decoder/exporter that emits the text interface documented in README.
tools/bin/hm_ipm/
tools/bin/hm_stego/
tools/decode_ipm.py

# Steganographic embedders and encoder implementations are also local-only.
# The repository publishes only steganalysis code and interface formats.
stego/
tools/bin/x265_candidates/
tools/bin/x265_recompress/
tools/reencode_calibration.py
tools/x265_candidates.py
